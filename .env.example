# =============================================================
# B2B Demo API — muhit o'zgaruvchilari (environment variables)
# -------------------------------------------------------------
# Bu faylni nusxalab `.env` nomi bilan saqlang:
#     cp .env.example .env
# So'ng qiymatlarni o'zingizga moslab to'ldiring.
# `.env` fayli HECH QACHON git'ga qo'shilmaydi (.gitignore da bor).
# =============================================================

# --- Server ---
# Server qaysi portda ishlashi
PORT=3000
# development | production | test
NODE_ENV=development

# --- Ma'lumotlar bazasi (PostgreSQL) ---
# Format: postgresql://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA_NOMI?schema=public
DATABASE_URL=postgresql://b2b:b2bpass@127.0.0.1:5432/b2b_demo?schema=public

# --- JWT (autentifikatsiya) ---
# Ikkala secret ham uzun, tasodifiy satr bo'lsin. Masalan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=bu_yerga_uzun_tasodifiy_satr_yozing_access
JWT_REFRESH_SECRET=bu_yerga_uzun_tasodifiy_satr_yozing_refresh
# Access token qancha yashaydi (qisqa bo'lishi kerak)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token qancha yashaydi (uzunroq)
JWT_REFRESH_EXPIRES_IN=7d

# --- imgbb (rasm saqlash xizmati) ---
# API kalitni https://api.imgbb.com/ saytidan bepul olasiz.
# Bo'sh qoldirsangiz — rasm yuklash endpointi 503 qaytaradi,
# qolgan API esa normal ishlayveradi.
IMGBB_API_KEY=
# imgbb yuklash manzili (odatda o'zgartirilmaydi)
IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload
# Yuklanadigan rasmning maksimal hajmi (bayt). 5 MB = 5242880
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Rate limiting (so'rovlar chekloviO ---
# Umumiy limit: RATE_LIMIT_WINDOW_MS oralig'ida RATE_LIMIT_MAX ta so'rov
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Auth endpointlari uchun qattiqroq limit (login/register)
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5

# --- Audit log ---
# Loglar necha kun saqlanadi (undan eskilari avtomatik o'chiriladi)
AUDIT_LOG_RETENTION_DAYS=7
# Tozalash job'i necha soatda bir ishga tushsin
AUDIT_CLEANUP_INTERVAL_HOURS=24

# --- Cache / background sync ---
# Server ishga tushganda DB'dan cache'ga yuklanadigan maksimal yozuvlar soni
CACHE_WARMUP_LIMIT=5000
# Cache'ni DB bilan AVTOMATIK sinxronlash oralig'i (daqiqada).
#   Cache uch yo'l bilan yangilanadi:
#     1) CRUD hodisalarida — darhol (avtomatik)
#     2) ADMIN qo'lda      — POST /api/v1/system/cache-reload
#                            yoki POST /api/v1/system/cache-refresh-now
#     3) Davriy            — mana shu sozlama (default: har 5 daqiqada)
#   0 qilinsa 3-usul o'chadi (1 va 2 ishlashda davom etadi).
CACHE_REFRESH_INTERVAL_MINUTES=5
# DB yozuvi xato bo'lsa necha marta qayta urinilsin
SYNC_MAX_RETRIES=3
# Retry'lar orasidagi boshlang'ich kutish (ms). Har urinishda 2 barobar oshadi.
SYNC_RETRY_BASE_DELAY_MS=500

# --- Seed (namunaviy ma'lumot) ---
# `npm run seed` ishga tushganda yaratiladigan admin
SEED_ADMIN_EMAIL=admin@b2b.uz
SEED_ADMIN_PASSWORD=Admin123!
